{
  "name": "martes",
  "version": "1.0.0",
  "description": "Local design canvas \u2014 34 SVG generators and a 360-texture browser, served from a single Node process.",
  "main": "./api.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legenki/martes.git"
  },
  "homepage": "https://legenki.github.io/martes/",
  "bugs": {
    "url": "https://github.com/legenki/martes/issues"
  },
  "keywords": [
    "svg",
    "generative-art",
    "design",
    "canvas",
    "vanilla-js",
    "no-build",
    "tile-patterns",
    "textures"
  ],
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "exports": {
    ".": "./api.js",
    "./core": "./assets/js/core.js",
    "./palettes": "./assets/js/palettes.data.js",
    "./tools/*": "./assets/js/tools/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "api.js",
    "assets/js/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./assets/js/registry.js",
    "./assets/js/actions.js",
    "./assets/js/keyboard.js",
    "./assets/js/textures.js",
    "./assets/js/palettes.js"
  ]
}
