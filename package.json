{
  "name": "@legenki/martes",
  "version": "0.1.0",
  "description": "34 seedable SVG pattern generators \u2014 headless API plus a zero-build design canvas.",
  "main": "./api.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legenki/martes.git"
  },
  "homepage": "https://legenki.github.io/martes/",
  "bugs": {
    "url": "https://github.com/legenki/martes/issues"
  },
  "keywords": [
    "svg",
    "generative-art",
    "design",
    "canvas",
    "vanilla-js",
    "no-build",
    "tile-patterns",
    "textures"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "exports": {
    ".": "./api.js",
    "./core": "./assets/js/core.js",
    "./palettes": "./assets/js/palettes.data.js",
    "./tools/*": "./assets/js/tools/*",
    "./package.json": "./package.json"
  },
  "files": [
    "api.js",
    "assets/js/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./assets/js/registry.js",
    "./assets/js/actions.js",
    "./assets/js/keyboard.js",
    "./assets/js/textures.js",
    "./assets/js/palettes.js"
  ],
  "publishConfig": {
    "access": "public"
  }
}
